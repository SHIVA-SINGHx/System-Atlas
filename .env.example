# System Atlas - Root Environment Template
# Copy to .env for local orchestration

# Infrastructure
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_password
POSTGRES_DB=atlas
REDIS_PASSWORD=atlas_dev_redis
REDIS_PORT=6379

# Service Communication Secret (min 32 chars)
INTERNAL_SERVICE_SECRET=atlas_internal_super_secret_key_32chars!

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
