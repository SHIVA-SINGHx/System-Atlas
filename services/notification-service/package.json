{
  "name": "@system-atlas/notification-service",
  "version": "0.1.0",
  "private": true,
  "description": "Email notifications, learning reminders, account notifications, BullMQ background jobs",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/terminus": "^10.2.3",
    "@prisma/client": "^6.1.0",
    "@system-atlas/config": "workspace:*",
    "@system-atlas/contracts": "workspace:*",
    "@system-atlas/logger": "workspace:*",
    "@system-atlas/observability": "workspace:*",
    "@system-atlas/types": "workspace:*",
    "@system-atlas/validation": "workspace:*",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1",
    
    "bullmq": "^5.37.0",
    "ioredis": "^5.4.2"
    
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "prisma": "^6.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}
