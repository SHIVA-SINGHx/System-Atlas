generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model InterviewProblem {
  id                 String          @id @default(uuid()) @db.Uuid
  slug               String          @unique
  title              String
  summary            String
  requirements       String          @db.Text
  trafficEstimation  String          @db.Text
  difficulty         DifficultyLevel @default(INTERMEDIATE)
  companies          String[]
  tags               String[]
  hints              String[]
  rubricCriteria     Json            @default("[]")
  createdAt          DateTime        @default(now())

  @@index([slug])
  @@index([difficulty])
  @@map("interview_problems")
}
